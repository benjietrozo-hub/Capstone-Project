# ============================================================
# backend/.env.railway  —  Copy these into Railway's Variables UI
# DO NOT commit real secrets. This is a reference template.
# ============================================================

APP_NAME="role-based-OIMS"
APP_ENV=production
APP_KEY=                        # Run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-backend.up.railway.app

# ── Database (use Railway MySQL/PostgreSQL plugin) ──────────
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQL_HOST}}   # Railway internal reference
DB_PORT=${{MySQL.MYSQL_PORT}}
DB_DATABASE=${{MySQL.MYSQL_DATABASE}}
DB_USERNAME=${{MySQL.MYSQL_USER}}
DB_PASSWORD=${{MySQL.MYSQL_PASSWORD}}

# ── Cache & Sessions (Redis plugin recommended) ─────────────
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=${{Redis.REDIS_HOST}}
REDIS_PORT=${{Redis.REDIS_PORT}}
REDIS_PASSWORD=${{Redis.REDIS_PASSWORD}}

# ── Mail (PHPMailer / SMTP) ─────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.up.railway.app

# ── Sanctum ──────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=your-frontend.up.railway.app

# ── WebSocket ────────────────────────────────────────────────
WEBSOCKET_HOST=your-websocket.up.railway.app
WEBSOCKET_PORT=443

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=stderr
LOG_LEVEL=error
